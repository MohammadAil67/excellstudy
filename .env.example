# ── MCP Server URLs ────────────────────────────────────────────────────────────
# Injected into agent containers as environment variables so they can call
# the platform MCP servers. Third-party agents use these directly with the
# FastMCP client. Built-in agents use PlatformMCPClient (services/mcp_client/).

LEARNER_CONTEXT_MCP_URL=http://localhost:8001
KNOWLEDGE_GRAPH_MCP_URL=http://localhost:8002
CONTENT_MCP_URL=http://localhost:8003

# ── Neo4j Knowledge Graph ─────────────────────────────────────────────────────
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Database (Supabase / PostgreSQL with pgvector) ────────────────────────────
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/excellstudy

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Agent Defaults ────────────────────────────────────────────────────────────
DEFAULT_AGENT_URL=http://localhost:8080
DEVELOPER_NAMESPACE=dev-alice

# ── GitHub Actions Workflow Dispatch API ──────────────────────────────────────
# Personal Access Token with repo scope (generated once by platform owner)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

